# Copy to .env.local and fill in. No real keys are committed to this repo.

# --- Site ---------------------------------------------------------------
# Used for canonical URLs, sitemap entries, OG tags, and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=https://nla-fabrication.example.com

# Where contact form submissions are delivered, and the address shown in the footer.
CONTACT_EMAIL=hello@nla-fabrication.example.com

# --- Stripe -------------------------------------------------------------
# Use a TEST key (sk_test_...) until the store is ready to take real money.
# Without this, the checkout button reports that checkout isn't live yet
# instead of failing.
STRIPE_SECRET_KEY=

# --- Resend -------------------------------------------------------------
# Without this, the contact form falls back to a prefilled mailto: link.
RESEND_API_KEY=
# Must be a verified sending domain in Resend. Falls back to Resend's
# onboarding@resend.dev sandbox sender if unset.
CONTACT_FROM_EMAIL=
