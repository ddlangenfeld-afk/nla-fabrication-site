# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.shots/

# Generated product renders. NOT committed on purpose: anything under public/
# is served at a real URL, and these are renders of geometry whose proportions
# are disputed — 16.5 x 20.3 x 16.5mm is near enough a cube for a part that
# should be a flat slider cap. Publishing them would put inaccurate product
# imagery on the site. Regenerate in one command once the dimensions are
# corrected against calipers:  node scripts/render-knobs.mjs
public/renders/
